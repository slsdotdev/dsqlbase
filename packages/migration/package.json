{
  "name": "@dsqlbase/migration",
  "version": "0.1.6",
  "description": "Migration tools for DSQLBase",
  "sideEffects": false,
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "sls.dev",
    "email": "dev@sls.dev",
    "url": "https://www.sls.dev"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/slsdotdev/dsqlbase#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slsdotdev/dsqlbase.git",
    "directory": "packages/migration"
  },
  "bugs": {
    "url": "https://github.com/slsdotdev/dsqlbase/issues"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "@dsqlbase/core": "^0.1.6"
  }
}
