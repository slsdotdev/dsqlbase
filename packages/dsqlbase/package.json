{
  "name": "dsqlbase",
  "version": "0.1.6",
  "description": "Query client and schema definition for distributed SQL databases",
  "sideEffects": false,
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "sls.dev",
    "email": "dev@sls.dev",
    "url": "https://www.sls.dev"
  },
  "keywords": [
    "SQL",
    "Aurora DSQL",
    "PostgreSQL"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/slsdotdev/dsqlbase#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slsdotdev/dsqlbase.git",
    "directory": "packages/dsqlbase"
  },
  "bugs": {
    "url": "https://github.com/slsdotdev/dsqlbase/issues"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./pg": {
      "types": "./dist/pg/index.d.ts",
      "default": "./dist/pg/index.js"
    },
    "./pglite": {
      "types": "./dist/pglite/index.d.ts",
      "default": "./dist/pglite/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "@dsqlbase/core": "^0.1.6"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "pg": "^8.20.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
